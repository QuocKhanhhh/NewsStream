{
  "name": "elasticsearch-news-sink",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
    "tasks.max": "1",
    "topics": "newsstream.newsdb.news",
    "connection.url": "http://elasticsearch:9200",
    "key.ignore": "false",
    "schema.ignore": "false",
    "behavior.on.null.values": "DELETE",
    "behavior.on.malformed.documents": "fail",
    "drop.invalid.message": "false",
    "max.retries": "5",
    "retry.backoff.ms": "1000",
    "batch.size": "200",
    "max.in.flight.requests": "1",
    "consumer.override.auto.offset.reset": "latest",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8081",
    "key.converter.key.subject.name.strategy": "io.confluent.kafka.serializers.subject.RecordNameStrategy",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter.value.subject.name.strategy": "io.confluent.kafka.serializers.subject.RecordNameStrategy",
    "transforms": "extractKey,dropMongoId",
    "transforms.extractKey.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.extractKey.field": "id",
    "transforms.dropMongoId.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.dropMongoId.exclude": "_id"
  }
}
